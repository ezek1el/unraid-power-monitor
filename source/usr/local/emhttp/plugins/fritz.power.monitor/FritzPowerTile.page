            <span id="fpmKwh">--</span> kWh/Jahr
        </div>
    </div>

    <svg class="fpm-spark" id="fpmSpark" preserveAspectRatio="none"
         viewBox="0 0 300 34" aria-hidden="true">
        <path class="area" d=""></path>
        <path class="line" d=""></path>
    </svg>

    <div class="fpm-stats">
        <span><i>&oslash;</i><span id="fpmAvg">--</span> W</span>
        <span><i>min</i><span id="fpmMin">--</span> W</span>
        <span><i>max</i><span id="fpmMax">--</span> W</span>
        <span><i>temp</i><span id="fpmTemp">--</span>&deg;C</span>
    </div>

    <div class="fpm-foot">
        <span id="fpmRange">&nbsp;</span>
        <span id="fpmAge">&nbsp;</span>
    </div>
</div>

<script>
(function () {
    'use strict';

    var API     = '/plugins/fritz.power.monitor/include/api.php';
    var REFRESH = <?= (int)($fpmCfg['REFRESH'] ?? 30) ?: 30 ?> * 1000;
    var WARN    = <?= (float)($fpmCfg['WARN_WATT'] ?? 60) ?: 60 ?>;
    var HIGH    = <?= (float)($fpmCfg['HIGH_WATT'] ?? 100) ?: 100 ?>;

    var timer = null;

    function $(id) { return document.getElementById(id); }

    function fmt(v, digits) {
        if (v === null || v === undefined) return '--';
        return Number(v).toFixed(digits === undefined ? 1 : digits);
    }

    function relAge(ts) {
        if (!ts) return '';
        var s = Math.max(0, Math.round((Date.now() - ts) / 1000));
        if (s < 90)   return 'vor ' + s + ' s';
        if (s < 5400) return 'vor ' + Math.round(s / 60) + ' min';
        return 'vor ' + Math.round(s / 3600) + ' h';
    }

    /* Baut Flaechen- und Linienpfad aus den Messpunkten. */
    function sparkline(points) {
        var svg = $('fpmSpark');
        if (!svg) return;
        var area = svg.querySelector('path.area');
        var line = svg.querySelector('path.line');

        if (!points || points.length < 2) {
            area.setAttribute('d', '');
            line.setAttribute('d', '');
            return;
        }

        var W = 300, H = 34, PAD = 2;
        var xs = points.map(function (p) { return p.t; });
        var ys = points.map(function (p) { return p.w; });

        var xMin = Math.min.apply(null, xs), xMax = Math.max.apply(null, xs);
        var yMin = Math.min.apply(null, ys), yMax = Math.max.apply(null, ys);

        // Flache Kurven brauchen Luft, sonst klebt die Linie am Rand
        if (yMax - yMin < 1) { yMax = yMin + 1; }
        var xSpan = (xMax - xMin) || 1;
        var ySpan = (yMax - yMin) || 1;

        var d = '';
        points.forEach(function (p, i) {
            var x = ((p.t - xMin) / xSpan) * W;
            var y = H - PAD - ((p.w - yMin) / ySpan) * (H - PAD * 2);
            d += (i === 0 ? 'M' : 'L') + x.toFixed(1) + ',' + y.toFixed(1);
        });

        line.setAttribute('d', d);
        area.setAttribute('d', d + 'L' + W + ',' + H + 'L0,' + H + 'Z');
    }

    function level(watt) {
        var el = $('fpmLvl');
        if (!el) return;
        el.classList.remove('fpm-lvl-ok', 'fpm-lvl-warn', 'fpm-lvl-high');
        el.classList.add(watt >= HIGH ? 'fpm-lvl-high'
                       : watt >= WARN ? 'fpm-lvl-warn'
                       : 'fpm-lvl-ok');
    }

    function showError(msg) {
        var el = $('fpmErr');
        if (!el) return;
        el.style.display = '';
        el.textContent = msg;
    }

    function render(d) {
        $('fpmErr').style.display = 'none';
        $('fpmWatt').textContent  = fmt(d.watt);
        $('fpmEur').textContent   = fmt(d.eur_year, 2);
        $('fpmKwh').textContent   = fmt(d.kwh_year, 0);
        $('fpmAvg').textContent   = fmt(d.avg);
        $('fpmMin').textContent   = fmt(d.min);
        $('fpmMax').textContent   = fmt(d.max);
        $('fpmTemp').textContent  = fmt(d.celsius);
        $('fpmRange').textContent = 'letzte ' + d.hours + ' h';
        $('fpmAge').textContent   = relAge(d.ts);

        level(d.watt);
        sparkline(d.series);
    }

    function poll() {
        if (!$('fpmWatt')) return;   // Kachel ausgeblendet
        fetch(API + '?_=' + Date.now(), { cache: 'no-store' })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (d && d.ok) { render(d); }
                else { showError(d && d.error ? d.error : 'Unbekannter Fehler'); }
            })
            .catch(function (e) { showError('Abfrage fehlgeschlagen: ' + e.message); });
    }

    function start() {
        poll();
        if (timer) clearInterval(timer);
        timer = setInterval(poll, REFRESH);
    }

    // Im Hintergrund nicht pollen - spart Requests bei unsichtbarem Tab
    document.addEventListener('visibilitychange', function () {
        if (document.hidden) { clearInterval(timer); timer = null; }
        else if (!timer) { start(); }
    });

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start);
    } else {
        start();
    }
})();
</script>
<?php endif; ?>
