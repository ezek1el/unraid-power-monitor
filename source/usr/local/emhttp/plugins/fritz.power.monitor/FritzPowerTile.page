<script>
(function () {
    'use strict';

    var API     = '/plugins/fritz.power.monitor/include/api.php';
    var REFRESH = <?= (int)($fpmCfg['REFRESH'] ?? 30) ?: 30 ?> * 1000;
    var WARN    = <?= (float)($fpmCfg['WARN_WATT'] ?? 60) ?: 60 ?>;
    var HIGH    = <?= (float)($fpmCfg['HIGH_WATT'] ?? 100) ?: 100 ?>;

    var timer = null;

    function $(id) { return document.getElementById(id); }

    function fmt(v, digits) {
        if (v === null || v === undefined) return '--';
        return Number(v).toFixed(digits === undefined ? 1 : digits);
    }

    function relAge(ts) {
        if (!ts) return '';
        var s = Math.max(0, Math.round((Date.now() - ts) / 1000));
        if (s < 90)   return 'vor ' + s + ' s';
        if (s < 5400) return 'vor ' + Math.round(s / 60) + ' min';
        return 'vor ' + Math.round(s / 3600) + ' h';
    }

    /* Rundet auf einen "huebschen" Skalenwert auf/ab. */
    function niceStep(span) {
        var raw = span / 3;
        var mag = Math.pow(10, Math.floor(Math.log(raw) / Math.LN10));
        var n   = raw / mag;
        var f   = n >= 5 ? 10 : n >= 2 ? 5 : n >= 1 ? 2 : 1;
        return f * mag;
    }

    function hhmm(ts) {
        var d = new Date(ts);
        return ('0' + d.getHours()).slice(-2) + ':' + ('0' + d.getMinutes()).slice(-2);
    }

    /* Zeichnet Gitter, Flaeche und Linie; beschriftet die Achsen. */
    function sparkline(points, hours) {
        var svg = $('fpmSpark');
        if (!svg) return;
        var area = svg.querySelector('path.area');
        var line = svg.querySelector('path.line');
        var grid = $('fpmGrid');

        if (!points || points.length < 2) {
            area.setAttribute('d', '');
            line.setAttribute('d', '');
            grid.innerHTML = '';
            return;
        }

        var W = 300, H = 60, PAD = 3;
        var xs = points.map(function (p) { return p.t; });
        var ys = points.map(function (p) { return p.w; });

        var xMin = Math.min.apply(null, xs), xMax = Math.max.apply(null, xs);
        var yLo  = Math.min.apply(null, ys), yHi  = Math.max.apply(null, ys);

        // Auf runde Werte erweitern, damit die Achse lesbare Zahlen zeigt
        var step = niceStep(Math.max(1, yHi - yLo));
        var yMin = Math.floor(yLo / step) * step;
        var yMax = Math.ceil(yHi / step) * step;
        if (yMax - yMin < step) { yMax = yMin + step; }

        var xSpan = (xMax - xMin) || 1;
        var ySpan = (yMax - yMin) || 1;

        function px(t) { return ((t - xMin) / xSpan) * W; }
        function py(w) { return H - PAD - ((w - yMin) / ySpan) * (H - PAD * 2); }

        // Waagerechte Hilfslinien auf den Skalenwerten
        var g = '';
        for (var v = yMin; v <= yMax + 0.001; v += step) {
            var y = py(v).toFixed(1);
            g += '<line class="grid" x1="0" y1="' + y + '" x2="' + W + '" y2="' + y + '"></line>';
        }
        // Senkrechte Marken, viertelweise ueber den Zeitraum
        for (var i = 1; i < 4; i++) {
            var x = (W * i / 4).toFixed(1);
            g += '<line class="grid" x1="' + x + '" y1="0" x2="' + x + '" y2="' + H + '"></line>';
        }
        grid.innerHTML = g;

        var d = '';
        points.forEach(function (p, i) {
            d += (i === 0 ? 'M' : 'L') + px(p.t).toFixed(1) + ',' + py(p.w).toFixed(1);
        });

        line.setAttribute('d', d);
        area.setAttribute('d', d + 'L' + W + ',' + H + 'L0,' + H + 'Z');

        // Achsenbeschriftung
        var dec = step < 1 ? 1 : 0;
        $('fpmAxMax').textContent  = yMax.toFixed(dec) + ' W';
        $('fpmAxMin').textContent  = yMin.toFixed(dec) + ' W';
        $('fpmAxT0').textContent   = hhmm(xMin);
        $('fpmAxSpan').textContent = hours + ' h';
    }

    function level(watt) {
        var el = $('fpmLvl');
        if (!el) return;
        el.classList.remove('fpm-lvl-ok', 'fpm-lvl-warn', 'fpm-lvl-high');
        el.classList.add(watt >= HIGH ? 'fpm-lvl-high'
                       : watt >= WARN ? 'fpm-lvl-warn'
                       : 'fpm-lvl-ok');
    }

    function showError(msg) {
        var el = $('fpmErr');
        if (!el) return;
        el.style.display = '';
        el.textContent = msg;
    }

    function render(d) {
        $('fpmErr').style.display = 'none';
        $('fpmWatt').textContent  = fmt(d.watt);
        $('fpmEur').textContent   = fmt(d.eur_year, 2);
        $('fpmKwh').textContent   = fmt(d.kwh_year, 0);
        $('fpmAvg').textContent   = fmt(d.avg);
        $('fpmTemp').textContent  = fmt(d.celsius);
        $('fpmAge').textContent   = relAge(d.ts);

        level(d.watt);
        sparkline(d.series, d.hours);
    }

    function poll() {
        if (!$('fpmWatt')) return;   // Kachel ausgeblendet
        fetch(API + '?_=' + Date.now(), { cache: 'no-store' })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (d && d.ok) { render(d); }
                else { showError(d && d.error ? d.error : 'Unbekannter Fehler'); }
            })
            .catch(function (e) { showError('Abfrage fehlgeschlagen: ' + e.message); });
    }

    function start() {
        poll();
        if (timer) clearInterval(timer);
        timer = setInterval(poll, REFRESH);
    }

    // Im Hintergrund nicht pollen - spart Requests bei unsichtbarem Tab
    document.addEventListener('visibilitychange', function () {
        if (document.hidden) { clearInterval(timer); timer = null; }
        else if (!timer) { start(); }
    });

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start);
    } else {
        start();
    }
})();
</script>
<?php endif; ?>
