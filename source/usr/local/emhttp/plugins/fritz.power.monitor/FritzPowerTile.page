<?php
/*
 * fritz-unraid-power-monitor - Dashboard-Tile
 * Registriert sich ueber $mytiles, damit die Kachel im Tile Management
 * auftaucht und per Drag&Drop sortierbar ist.
 */

$fpmCfgFile = '/boot/config/plugins/fritz.power.monitor/settings.cfg';
$fpmCfg = is_file($fpmCfgFile) ? (@parse_ini_file($fpmCfgFile) ?: []) : [];
$fpmCfg = array_change_key_case($fpmCfg, CASE_UPPER);

$fpmConfigured = !empty($fpmCfg['INFLUX_URL']) && !empty($fpmCfg['DEVICE']);

ob_start();

if (!$fpmConfigured):
?>
<div style="padding:6px 2px;font-size:12px;">
  Bitte <a href="/Settings/FritzPowerSettings">Einstellungen konfigurieren</a>
</div>
<?php else: ?>
