Menu="Dashboard:1"
Title="Stromverbrauch"
Icon="icon-u-power"
Tag="bolt"
Cond="is_file('/boot/config/plugins/fritz.power.monitor/settings.cfg')"
---
<?PHP
/*
 * fritz-unraid-power-monitor - Dashboard-Tile
 */
$fpmVersion = '0.1.0';

$fpmCfgFile = '/boot/config/plugins/fritz.power.monitor/settings.cfg';
$fpmCfg = is_file($fpmCfgFile) ? (@parse_ini_file($fpmCfgFile) ?: []) : [];
$fpmCfg = array_change_key_case($fpmCfg, CASE_UPPER);
?>

<style>
.fpm-wrap {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 4px 2px;
    font-size: 1.2rem;
}
.fpm-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
}
.fpm-now {
    font-size: 2.6rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
}
.fpm-now small {
    font-size: 1.3rem;
    font-weight: 400;
    opacity: .7;
    margin-left: 3px;
}
.fpm-cost {
    text-align: right;
    line-height: 1.35;
    white-space: nowrap;
}
.fpm-cost b { font-size: 1.5rem; }
.fpm-cost span { opacity: .65; font-size: 1.05rem; }

.fpm-spark {
    width: 100%;
    height: 46px;
    display: block;
}
.fpm-spark path.area { fill: currentColor; opacity: .16; }
.fpm-spark path.line { fill: none; stroke: currentColor; stroke-width: 1.6; }

.fpm-stats {
    display: flex;
    justify-content: space-between;
    gap: 6px;
    flex-wrap: wrap;
    font-size: 1.05rem;
    opacity: .8;
}
.fpm-stats i { font-style: normal; opacity: .6; margin-right: 3px; }

.fpm-foot {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font-size: .95rem;
    opacity: .55;
}
.fpm-err {
    padding: 6px 2px;
    font-size: 1.1rem;
    color: #e0605e;
}
/* Ampel nach Verbrauch - Schwellen kommen aus den Einstellungen */
.fpm-lvl-ok   { color: #4ea24e; }
.fpm-lvl-warn { color: #d8a013; }
.fpm-lvl-high { color: #e0605e; }
</style>

<div class="fpm-wrap" id="fpmWrap">
    <div class="fpm-err" id="fpmErr" style="display:none"></div>

    <div class="fpm-head">
        <div class="fpm-now" id="fpmLvl">
            <span id="fpmWatt">--</span><small>W</small>
        </div>
        <div class="fpm-cost">
            <b id="fpmEur">--</b> <span>&euro;/Jahr</span><br>
            <span id="fpmKwh">--</span> <span>kWh/Jahr</span>
        </div>
    </div>

    <svg class="fpm-spark" id="fpmSpark" preserveAspectRatio="none"
         viewBox="0 0 300 46" aria-hidden="true">
        <path class="area" d=""></path>
        <path class="line" d=""></path>
    </svg>

    <div class="fpm-stats">
        <div><i>&oslash;</i><span id="fpmAvg">--</span> W</div>
        <div><i>min</i><span id="fpmMin">--</span> W</div>
        <div><i>max</i><span id="fpmMax">--</span> W</div>
        <div><i>temp</i><span id="fpmTemp">--</span> &deg;C</div>
    </div>

    <div class="fpm-foot">
        <span id="fpmRange">&nbsp;</span>
        <span id="fpmAge">&nbsp;</span>
    </div>
</div>

<script>
(function () {
    'use strict';

    var API      = '/plugins/fritz.power.monitor/include/api.php';
    var REFRESH  = <?= (int)(($fpmCfg['REFRESH'] ?? 30)) ?: 30 ?> * 1000;
    var WARN     = <?= (float)(($fpmCfg['WARN_WATT'] ?? 60)) ?: 60 ?>;
    var HIGH     = <?= (float)(($fpmCfg['HIGH_WATT'] ?? 100)) ?: 100 ?>;

    var timer = null;

    function $(id) { return document.getElementById(id); }

    function fmt(v, digits) {
        if (v === null || v === undefined) return '--';
        return Number(v).toFixed(digits === undefined ? 1 : digits);
    }

    function relAge(ts) {
        if (!ts) return '';
        var s = Math.max(0, Math.round((Date.now() - ts) / 1000));
        if (s < 90)   return 'vor ' + s + ' s';
        if (s < 5400) return 'vor ' + Math.round(s / 60) + ' min';
        return 'vor ' + Math.round(s / 3600) + ' h';
    }

    /* Baut Flaechen- und Linienpfad aus den Messpunkten. */
    function sparkline(points) {
        var svg  = $('fpmSpark');
        var area = svg.querySelector('path.area');
        var line = svg.querySelector('path.line');

        if (!points || points.length < 2) {
            area.setAttribute('d', '');
            line.setAttribute('d', '');
            return;
        }

        var W = 300, H = 46, PAD = 2;
        var xs = points.map(function (p) { return p.t; });
        var ys = points.map(function (p) { return p.w; });

        var xMin = Math.min.apply(null, xs), xMax = Math.max.apply(null, xs);
        var yMin = Math.min.apply(null, ys), yMax = Math.max.apply(null, ys);

        // Flache Kurven brauchen etwas Luft, sonst klebt die Linie am Rand
        if (yMax - yMin < 1) { yMax = yMin + 1; }
        var xSpan = (xMax - xMin) || 1;
        var ySpan = (yMax - yMin) || 1;

        var d = '';
        points.forEach(function (p, i) {
            var x = ((p.t - xMin) / xSpan) * W;
            var y = H - PAD - ((p.w - yMin) / ySpan) * (H - PAD * 2);
            d += (i === 0 ? 'M' : 'L') + x.toFixed(1) + ',' + y.toFixed(1);
        });

        line.setAttribute('d', d);
        area.setAttribute('d', d + 'L' + W + ',' + H + 'L0,' + H + 'Z');
    }

    function level(watt) {
        var el = $('fpmLvl');
        el.classList.remove('fpm-lvl-ok', 'fpm-lvl-warn', 'fpm-lvl-high');
        el.classList.add(watt >= HIGH ? 'fpm-lvl-high'
                       : watt >= WARN ? 'fpm-lvl-warn'
                       : 'fpm-lvl-ok');
    }

    function showError(msg) {
        $('fpmErr').style.display = '';
        $('fpmErr').textContent = msg;
    }

    function render(d) {
        $('fpmErr').style.display = 'none';

        $('fpmWatt').textContent = fmt(d.watt);
        $('fpmEur').textContent  = fmt(d.eur_year, 2);
        $('fpmKwh').textContent  = fmt(d.kwh_year, 0);
        $('fpmAvg').textContent  = fmt(d.avg);
        $('fpmMin').textContent  = fmt(d.min);
        $('fpmMax').textContent  = fmt(d.max);
        $('fpmTemp').textContent = fmt(d.celsius);
        $('fpmRange').textContent = 'letzte ' + d.hours + ' h';
        $('fpmAge').textContent   = relAge(d.ts);

        level(d.watt);
        sparkline(d.series);
    }

    function poll() {
        fetch(API + '?_=' + Date.now(), { cache: 'no-store' })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (d && d.ok) { render(d); }
                else { showError(d && d.error ? d.error : 'Unbekannter Fehler'); }
            })
            .catch(function (e) {
                showError('Abfrage fehlgeschlagen: ' + e.message);
            });
    }

    function start() {
        poll();
        if (timer) clearInterval(timer);
        timer = setInterval(poll, REFRESH);
    }

    // Im Hintergrund nicht pollen - spart Requests, wenn der Tab nicht sichtbar ist
    document.addEventListener('visibilitychange', function () {
        if (document.hidden) { clearInterval(timer); timer = null; }
        else if (!timer) { start(); }
    });

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start);
    } else {
        start();
    }
})();
</script>
