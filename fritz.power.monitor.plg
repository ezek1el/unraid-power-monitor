<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "fritz.power.monitor">
<!ENTITY author    "ezek1el3000">
<!ENTITY version   "2026.08.01">
<!ENTITY launch    "Settings/FritzPowerSettings">
<!ENTITY gitURL    "https://raw.githubusercontent.com/ezek1el/fritz-unraid-power-monitor/main">
<!ENTITY pluginURL "&gitURL;/&name;.plg">
<!ENTITY pkgURL    "&gitURL;/packages">
<!ENTITY plgPATH   "/boot/config/plugins/&name;">
<!ENTITY emhttp    "/usr/local/emhttp/plugins/&name;">
]>

<PLUGIN name="&name;"
        author="&author;"
        version="&version;"
        launch="&launch;"
        pluginURL="&pluginURL;"
        min="6.12.0"
        support="https://github.com/ezek1el/fritz-unraid-power-monitor/issues"
        icon="bolt">

<CHANGES>
###2026.08.01
- Erste Version
- Dashboard-Tile mit aktuellem Verbrauch, Sparkline, Min/Mittel/Max
- Hochrechnung kWh und Euro pro Jahr
- Einstellungsseite inkl. Verbindungstest
</CHANGES>

<!-- Standard-Konfiguration anlegen, bestehende nicht ueberschreiben -->
<FILE Run="/bin/bash">
<INLINE>
mkdir -p &plgPATH;

if [ ! -f "&plgPATH;/settings.cfg" ]; then
  cat > "&plgPATH;/settings.cfg" &lt;&lt;'EOF'
INFLUX_URL="http://192.168.88.100:8086"
INFLUX_DB="fritzbox"
INFLUX_USER=""
INFLUX_PASS=""
DEVICE="steckdose_fileserver"
PRICE_KWH="0.2656"
HISTORY_HRS="6"
REFRESH="30"
WARN_WATT="60"
HIGH_WATT="100"
EOF
  echo "Standardkonfiguration angelegt."
else
  echo "Bestehende Konfiguration beibehalten."
fi
</INLINE>
</FILE>

<FILE Name="&plgPATH;/&name;-&version;.txz" Run="upgradepkg --install-new">
<URL>&pkgURL;/&name;-&version;.txz</URL>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
echo ""
echo "----------------------------------------------------"
echo " &name; &version; installiert."
echo " Einstellungen: Settings -> Stromverbrauch (FRITZ!)"
echo "----------------------------------------------------"
echo ""
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
removepkg &name;
rm -rf &emhttp;
rm -f /boot/config/plugins/&name;/*.txz
echo "Plugin entfernt. Konfiguration bleibt unter &plgPATH; erhalten."
</INLINE>
</FILE>

</PLUGIN>
